# Sent to Cloud Build when deploying with `gcloud run deploy --source .`
# Keep the upload small: only what apps/api/Dockerfile actually COPYs.
.git/
node_modules/
**/node_modules/
**/dist/
**/.next/
**/build/
**/coverage/
*.tsbuildinfo

# Other apps — not part of the API image
apps/player/
apps/web/
docs/

# Secrets / local env — never ship these
.env
.env.*
!.env.example
**/secrets/
*serviceAccount*.json
firebase-adminsdk*.json

# Local-only planning notes
project-plan.md
STANDUP.md
ASSIGNMENT_BRIEF.md
FIREBASE_SETUP.md
figma-findings.md
cloud-run-plan.md
*.md

# Copy to .env (or .env.local) and fill in. Never commit the real file.

NODE_ENV=development
PORT=3000

# ── Firebase ────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=zporter-challenge-app
FIREBASE_STORAGE_BUCKET=zporter-challenge-app.appspot.com

# Local dev — pick ONE credential source:
#   a) path to a service-account JSON key
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccount.json
#   b) the key inline (raw JSON or base64) — handy for Cloud Run env vars
# FIREBASE_SERVICE_ACCOUNT_KEY=

# In production (Cloud Run) set NEITHER of the above — the runtime service
# account is picked up automatically via Application Default Credentials.

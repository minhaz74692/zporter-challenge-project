# Copy to .env (or .env.local) and fill in. Never commit the real file.

NODE_ENV=development
PORT=3000

# ── Firebase ────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=zporter-challenge-app
# Cloud Storage bucket — required for avatar / challenge-cover uploads.
# Check the console (Storage → the gs:// URL); recent projects use
# <project>.firebasestorage.app, older ones <project>.appspot.com.
FIREBASE_STORAGE_BUCKET=zporter-challenge-app.firebasestorage.app

# Local dev — pick ONE credential source:
#   a) path to a service-account JSON key
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccount.json
#   b) the key inline (raw JSON or base64) — handy for Cloud Run env vars
# FIREBASE_SERVICE_ACCOUNT_KEY=

# In production (Cloud Run) set NEITHER of the above — the runtime service
# account is picked up automatically via Application Default Credentials.

# ── Auth ────────────────────────────────────────────────────────────────────
# Long random string; rotate to invalidate every access token at once.
JWT_ACCESS_SECRET=dev-only-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14

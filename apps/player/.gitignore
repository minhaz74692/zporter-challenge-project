# Local dev config (machine-specific API URL)
/config/local.json

# Firebase per-project config (add locally; see apps/player/FCM_SETUP.md)
# Paths are relative to this file's dir (apps/player/) — the earlier
# repo-root-style paths never matched, which leaked the API key.
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist

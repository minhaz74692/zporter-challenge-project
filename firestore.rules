rules_version = '2';

// Defense in depth. Every read and write goes through the NestJS API using the
// Firebase Admin SDK, which bypasses these rules entirely. No client — the
// Flutter player app, the Next.js web app, or anything else — is allowed to
// touch Firestore directly. If a request is ever evaluated against these rules,
// it is by definition unauthorised.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
